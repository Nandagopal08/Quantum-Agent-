# Copy to .env and export before running scripts (or pass --storage-mode/--drive-root/--drive-mount to any script).
# colab:       Google Drive mounted in Colab (default)
# desktop:     Google Drive for desktop, e.g. QADT_DRIVE_MOUNT=~/Library/CloudStorage/GoogleDrive-<account>
# development: plain local folder (NOT Google Drive; the dashboard shows a warning banner)
QADT_STORAGE_MODE=development
QADT_DRIVE_ROOT=./.dev_storage
# QADT_DRIVE_MOUNT=/content/drive
# QADT_API_TOKEN=            # required on every /api call when set (run_backend.py --tunnel sets one)
# QADT_LLM_PROVIDER=ollama   # ollama | openai | none
# QADT_LLM_MODEL=llama3.1
# OPENAI_API_KEY=
# QADT_DATABASE_URL=postgresql+psycopg://user:pass@host/db   # optional; SQLite in storage by default
